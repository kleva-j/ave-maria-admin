# Keep the server version pinned; upgrade deliberately after reviewing the release.
TAG=v2.51.0
TWENTY_PORT=3000
SERVER_URL=http://localhost:3000

# Generated by ./scripts/setup.sh. Use hex values so the database URL is safe.
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=GENERATE_ME
PG_DATABASE_NAME=twenty
PG_DATABASE_URL=GENERATE_ME
ENCRYPTION_KEY=GENERATE_ME
FALLBACK_ENCRYPTION_KEY=GENERATE_ME
APP_SECRET=GENERATE_ME

STORAGE_TYPE=local

# Required only when using the ngrok tunnel profile.
NGROK_AUTHTOKEN=
